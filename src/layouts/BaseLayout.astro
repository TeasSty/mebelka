---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  immersiveHeader?: boolean;
}

const { title, description, path, ogImage, immersiveHeader = false } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <Seo title={title} description={description} path={path} ogImage={ogImage} />
  </head>
  <body class:list={[{ 'body--immersive': immersiveHeader }]}>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <Header immersive={immersiveHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { initEffects } from '../scripts/effects';
      initEffects();
    </script>
  </body>
</html>

<style is:global>
  main {
    min-height: calc(100vh - var(--header-height));
  }

  .body--immersive .header {
    position: absolute;
    inset-inline: 0;
    top: 0;
    background: transparent;
    border-bottom-color: transparent;
  }

  .body--immersive .header__brand,
  .body--immersive .header__list a,
  .body--immersive .header__phone {
    color: #f8f2ea;
  }

  .body--immersive .header__tag {
    color: rgb(248 242 234 / 0.65);
  }

  .body--immersive .header__toggle {
    border-color: rgb(255 255 255 / 0.25);
    background: rgb(255 255 255 / 0.08);
  }

  .body--immersive .header__toggle span[aria-hidden='true'] {
    background: #f8f2ea;
  }
</style>
