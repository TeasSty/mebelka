---
import { categories } from '../data/categories';
import { withBase } from '../lib/paths';
import ResponsiveImage from './ResponsiveImage.astro';
---

<div class="category-grid">
  {
    categories.map((cat) => (
      <a class="category-card" href={withBase(cat.path)}>
        <div class="category-card__media">
          <ResponsiveImage
            name={cat.heroImage}
            alt={cat.name}
            width={1080}
            height={810}
            sizes="(min-width: 960px) 33vw, (min-width: 640px) 50vw, 100vw"
            class="category-card__img"
          />
        </div>
        <div class="category-card__body">
          <h3 class="category-card__title">{cat.shortName}</h3>
          <p class="category-card__text">{cat.headline}</p>
          <span class="category-card__link">Смотреть →</span>
        </div>
      </a>
    ))
  }
</div>

<style>
  .category-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--color-panel);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .category-card:hover {
    color: inherit;
    transform: translateY(-3px);
    box-shadow: var(--shadow-soft);
  }

  .category-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
  }

  :global(.category-card__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .category-card:hover :global(.category-card__img) {
    transform: scale(1.02);
  }

  .category-card__body {
    padding: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }

  .category-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
  }

  .category-card__text {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .category-card__link {
    margin-top: var(--space-2);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  @media (min-width: 640px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .category-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .category-card:last-child:nth-child(3n + 1) {
      grid-column: span 1;
    }
  }
</style>
