---
import { withBase } from '../lib/paths';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const modelSrc = withBase('/models/kitchen-counter.gltf');
const posterSrc = withBase('/images/hero-kitchen.jpg');
---

<div class:list={['model-stage', className]}>
  <div class="model-stage__glow" aria-hidden="true"></div>
  <model-viewer
    class="model-stage__viewer"
    src={modelSrc}
    poster={posterSrc}
    alt="Интерактивная 3D-модель кухонного модуля"
    camera-controls
    touch-action="pan-y"
    shadow-intensity="0.6"
    exposure="1.05"
    environment-image="neutral"
    interaction-prompt="none"
    data-model-viewer
  >
    <p slot="poster" class="model-stage__fallback">
      Загрузка 3D-модели…
    </p>
  </model-viewer>
  <p class="model-stage__hint">Поверните модель — CC0 Kitchen Counter · KayKit</p>
</div>

<style>
  .model-stage {
    position: relative;
    isolation: isolate;
    border-radius: var(--radius-lg);
    background: linear-gradient(165deg, #fff 0%, var(--color-surface) 100%);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    min-height: 18rem;
  }

  .model-stage__glow {
    position: absolute;
    inset: 10% 15% auto;
    height: 40%;
    background: radial-gradient(ellipse, rgb(193 127 89 / 0.18), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .model-stage__viewer {
    position: relative;
    z-index: 1;
    width: 100%;
    height: clamp(16rem, 42vw, 22rem);
    background: transparent;
    --poster-color: transparent;
  }

  .model-stage__fallback {
    display: grid;
    place-items: center;
    height: 100%;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .model-stage__hint {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    font-size: 0.75rem;
    color: var(--color-muted);
    text-align: center;
    border-top: 1px solid var(--color-line);
    background: rgb(255 255 255 / 0.6);
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const viewer = document.querySelector('[data-model-viewer]');

  if (viewer instanceof HTMLElement && !reducedMotion) {
    viewer.setAttribute('auto-rotate', '');
    viewer.setAttribute('rotation-per-second', '12deg');
    viewer.setAttribute('camera-orbit', '45deg 72deg 2.2m');
  } else if (viewer instanceof HTMLElement) {
    viewer.setAttribute('camera-orbit', '0deg 75deg 2.4m');
  }
</script>
