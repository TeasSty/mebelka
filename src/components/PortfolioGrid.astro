---
import ResponsiveImage from './ResponsiveImage.astro';
import type { PortfolioItem } from '../data/portfolio';

interface Props {
  items: PortfolioItem[];
  limit?: number;
}

const { items, limit } = Astro.props;
const visible = limit ? items.slice(0, limit) : items;
---

<ul class="portfolio-grid">
  {
    visible.map((item) => (
      <li class="portfolio-grid__item" data-category={item.category}>
        <figure class="portfolio-grid__figure">
          <div class="portfolio-grid__frame">
            <ResponsiveImage
              name={item.image}
              alt={item.alt}
              width={item.width}
              height={item.height}
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 45vw"
              class="portfolio-grid__img"
            />
          </div>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .portfolio-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(2, 1fr);
  }

  .portfolio-grid__item {
    margin: 0;
  }

  .portfolio-grid__figure {
    margin: 0;
  }

  .portfolio-grid__frame {
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-soft);
    max-height: 10.5rem;
  }

  :global(.portfolio-grid__img) {
    width: 100%;
    height: 100%;
    max-height: 10.5rem;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  @media (min-width: 640px) {
    .portfolio-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }

    .portfolio-grid__frame,
    :global(.portfolio-grid__img) {
      max-height: 12rem;
    }
  }

  @media (min-width: 1024px) {
    .portfolio-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .portfolio-grid__frame,
    :global(.portfolio-grid__img) {
      max-height: 13rem;
    }
  }
</style>
