---
import { site } from '../data/site';

const primaryPhone = site.phones.find((p) => p.primary) ?? site.phones[0];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__brand">{site.name}</p>
      <p class="footer__text">{site.tagline} · {site.city}</p>
      <p class="footer__text">{site.address.full}</p>
    </div>

    <div>
      <p class="footer__label">Связь</p>
      <p><a href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a></p>
      {
        site.phones
          .filter((p) => !p.primary)
          .map((p) => (
            <p>
              <a href={`tel:${p.tel}`}>{p.display}</a>
            </p>
          ))
      }
      <p><a href={site.messengers.whatsapp}>WhatsApp</a></p>
      <p><a href={site.messengers.vk}>ВКонтакте</a></p>
    </div>

    <div>
      <p class="footer__label">Режим работы</p>
      {
        site.hours.map((h) => (
          <p class="footer__text">
            {h.days}: {h.time}
          </p>
        ))
      }
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {year} {site.name}</p>
    <p><a href={site.vk.albumsUrl}>Все фото во ВКонтакте</a></p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-8) var(--space-6);
    background: var(--color-walnut);
    color: rgb(250 247 242 / 0.92);
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .footer__grid {
    display: grid;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  .footer__brand {
    font-family: var(--font-display);
    font-size: 1.75rem;
    margin: 0 0 var(--space-2);
  }

  .footer__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
    margin: 0 0 var(--space-3);
  }

  .footer__text {
    margin: 0 0 var(--space-2);
    color: rgb(255 255 255 / 0.75);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-5);
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.55);
  }

  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 1.2fr 1fr 0.8fr;
    }
  }
</style>
