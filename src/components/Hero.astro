---
import { site } from '../data/site';
import { withBase } from '../lib/paths';
import ResponsiveImage from './ResponsiveImage.astro';

const primaryPhone = site.phones.find((p) => p.primary) ?? site.phones[0];
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Warm workshop grid + blueprint decor -->
  <div class="hero__backdrop" aria-hidden="true">
    <svg class="hero__grid" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" preserveAspectRatio="none">
      <defs>
        <pattern id="hero-grid" width="32" height="32" patternUnits="userSpaceOnUse">
          <path d="M 32 0 L 0 0 0 32" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.35"/>
        </pattern>
        <pattern id="hero-grid-major" width="160" height="160" patternUnits="userSpaceOnUse">
          <rect width="160" height="160" fill="url(#hero-grid)"/>
          <path d="M 160 0 L 0 0 0 160" fill="none" stroke="currentColor" stroke-width="0.75" opacity="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid-major)"/>
    </svg>

    <!-- Kitchen elevation blueprint — warm lines, not CAD blue -->
    <svg class="hero__blueprint" viewBox="0 0 420 280" xmlns="http://www.w3.org/2000/svg" fill="none">
      <!-- Base cabinet row -->
      <rect x="40" y="160" width="90" height="72" stroke="currentColor" stroke-width="1.25"/>
      <rect x="130" y="160" width="60" height="72" stroke="currentColor" stroke-width="1.25"/>
      <line x1="160" y1="160" x2="160" y2="232" stroke="currentColor" stroke-width="0.75" stroke-dasharray="4 3"/>
      <!-- Wall cabinets -->
      <rect x="40" y="72" width="90" height="56" stroke="currentColor" stroke-width="1.25"/>
      <rect x="130" y="72" width="60" height="56" stroke="currentColor" stroke-width="1.25"/>
      <!-- Tall unit -->
      <rect x="200" y="72" width="56" height="160" stroke="currentColor" stroke-width="1.25"/>
      <line x1="228" y1="72" x2="228" y2="232" stroke="currentColor" stroke-width="0.75" stroke-dasharray="4 3"/>
      <!-- Countertop -->
      <line x1="36" y1="160" x2="260" y2="160" stroke="currentColor" stroke-width="1.5"/>
      <!-- Dimension: width -->
      <line x1="40" y1="248" x2="256" y2="248" stroke="currentColor" stroke-width="0.75"/>
      <line x1="40" y1="242" x2="40" y2="254" stroke="currentColor" stroke-width="0.75"/>
      <line x1="256" y1="242" x2="256" y2="254" stroke="currentColor" stroke-width="0.75"/>
      <text x="148" y="268" text-anchor="middle" fill="currentColor" font-size="11" font-family="system-ui, sans-serif" letter-spacing="0.08em">3200</text>
      <!-- Dimension: height -->
      <line x1="280" y1="72" x2="280" y2="232" stroke="currentColor" stroke-width="0.75"/>
      <line x1="274" y1="72" x2="286" y2="72" stroke="currentColor" stroke-width="0.75"/>
      <line x1="274" y1="232" x2="286" y2="232" stroke="currentColor" stroke-width="0.75"/>
      <text x="296" y="156" fill="currentColor" font-size="11" font-family="system-ui, sans-serif" letter-spacing="0.08em" transform="rotate(90 296 156)">2400</text>
      <!-- Module labels -->
      <text x="85" y="200" text-anchor="middle" fill="currentColor" font-size="9" font-family="system-ui, sans-serif" opacity="0.7">600</text>
      <text x="160" y="200" text-anchor="middle" fill="currentColor" font-size="9" font-family="system-ui, sans-serif" opacity="0.7">450</text>
      <text x="228" y="156" text-anchor="middle" fill="currentColor" font-size="9" font-family="system-ui, sans-serif" opacity="0.7">600</text>
    </svg>

    <!-- Top-down room layout hint -->
    <svg class="hero__plan" viewBox="0 0 120 100" xmlns="http://www.w3.org/2000/svg" fill="none">
      <rect x="8" y="8" width="104" height="84" stroke="currentColor" stroke-width="1"/>
      <rect x="8" y="8" width="52" height="28" stroke="currentColor" stroke-width="0.75" stroke-dasharray="3 2"/>
      <rect x="60" y="8" width="52" height="28" stroke="currentColor" stroke-width="0.75"/>
      <rect x="8" y="60" width="36" height="32" stroke="currentColor" stroke-width="0.75"/>
      <circle cx="96" cy="76" r="6" stroke="currentColor" stroke-width="0.75"/>
      <text x="60" y="54" text-anchor="middle" fill="currentColor" font-size="7" font-family="system-ui, sans-serif" opacity="0.6">план</text>
    </svg>
  </div>

  <div class="container hero__shell">
    <div class="hero__content">
      <p class="hero__eyebrow">
        <span class="hero__eyebrow-mark" aria-hidden="true"></span>
        {site.city} · корпусная мебель на заказ
      </p>

      <h1 id="hero-title">{site.offer.headline}</h1>
      <p class="hero__lead">{site.offer.subline}</p>

      <ul class="hero__chips" aria-label="Преимущества">
        <li class="hero__chip">
          <span class="hero__chip-label">Рейтинг VK</span>
          <span class="hero__chip-value">{site.vk.rating}</span>
        </li>
        <li class="hero__chip">
          <span class="hero__chip-label">Замер</span>
          <span class="hero__chip-value">бесплатно</span>
        </li>
        <li class="hero__chip">
          <span class="hero__chip-label">Производство</span>
          <span class="hero__chip-value">своё</span>
        </li>
      </ul>

      <ul class="hero__list">
        <li>Кухни и шкафы-купе по вашим размерам</li>
        <li>Доставка и монтаж в {site.city}</li>
      </ul>

      <div class="hero__actions">
        <a class="btn btn--primary" href={withBase('/kontakty#zamer')}>{site.offer.cta}</a>
        <a class="btn btn--secondary" href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a>
      </div>
    </div>

    <figure class="hero__visual">
      <!-- Catalog-style dimension frame -->
      <div class="hero__catalog" aria-hidden="true">
        <span class="hero__dim hero__dim--top">
          <svg width="12" height="6" viewBox="0 0 12 6" aria-hidden="true"><path d="M0 3h12M0 3l2-2M0 3l2 2M12 3l-2-2M12 3l-2 2" stroke="currentColor" stroke-width="0.75" fill="none"/></svg>
          3200 мм
        </span>
        <span class="hero__dim hero__dim--side">
          <svg width="6" height="12" viewBox="0 0 6 12" aria-hidden="true"><path d="M3 0v12M3 0l-2 2M3 0l2 2M3 12l-2-2M3 12l2-2" stroke="currentColor" stroke-width="0.75" fill="none"/></svg>
          2400
        </span>
        <!-- Corner registration marks -->
        <svg class="hero__corner hero__corner--tl" viewBox="0 0 16 16" aria-hidden="true"><path d="M0 8V0h8" stroke="currentColor" stroke-width="1" fill="none"/></svg>
        <svg class="hero__corner hero__corner--tr" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0h8v8" stroke="currentColor" stroke-width="1" fill="none"/></svg>
        <svg class="hero__corner hero__corner--bl" viewBox="0 0 16 16" aria-hidden="true"><path d="M0 8v8h8" stroke="currentColor" stroke-width="1" fill="none"/></svg>
        <svg class="hero__corner hero__corner--br" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 16V8H16" stroke="currentColor" stroke-width="1" fill="none"/></svg>
      </div>

      <div class="hero__mat">
        <ResponsiveImage
          name="hero-kitchen"
          alt="Кухня на заказ — работа МебельКа, Йошкар-Ола"
          width={1280}
          height={960}
          loading="eager"
          fetchpriority="high"
          sizes="(min-width: 960px) min(44vw, 520px), 100vw"
          class="hero__photo"
        />
        <span class="hero__stamp hero__stamp--size">по вашим размерам</span>
        <span class="hero__stamp hero__stamp--measure">замер бесплатно</span>
      </div>

      <!-- Workshop ruler decor -->
      <svg class="hero__ruler" viewBox="0 0 200 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="0" y="8" width="200" height="8" fill="var(--color-wood)" opacity="0.12" rx="1"/>
        <line x1="0" y1="12" x2="200" y2="12" stroke="var(--color-wood)" stroke-width="0.75" opacity="0.5"/>
        {Array.from({ length: 21 }).map((_, i) => (
          <line
            x1={i * 10}
            y1={i % 5 === 0 ? 6 : 9}
            x2={i * 10}
            y2="18"
            stroke="var(--color-wood)"
            stroke-width={i % 5 === 0 ? 1 : 0.5}
            opacity={i % 5 === 0 ? 0.6 : 0.35}
          />
        ))}
        <text x="100" y="22" text-anchor="middle" fill="var(--color-wood)" font-size="7" font-family="system-ui, sans-serif" opacity="0.5">мм</text>
      </svg>

      <figcaption class="hero__caption">Фото из наших работ · <a href={site.vk.url}>ВКонтакте</a></figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 5vw, 3.25rem);
    background: linear-gradient(180deg, var(--color-panel) 0%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-line);
    overflow: hidden;
  }

  /* ── Backdrop layers ── */
  .hero__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: var(--color-line);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    color: #d4cdc3;
    opacity: 0.55;
    mask-image: linear-gradient(135deg, black 0%, transparent 65%);
  }

  .hero__blueprint {
    position: absolute;
    left: -2%;
    bottom: 8%;
    width: min(52vw, 380px);
    height: auto;
    color: var(--color-wood);
    opacity: 0.14;
  }

  .hero__plan {
    position: absolute;
    right: 4%;
    top: 12%;
    width: 5.5rem;
    height: auto;
    color: var(--color-muted);
    opacity: 0.12;
  }

  .hero__shell {
    position: relative;
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .hero__content {
    max-width: 36rem;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero__eyebrow-mark {
    flex-shrink: 0;
    width: 2rem;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent) 0%, var(--color-wood) 100%);
    border-radius: 1px;
  }

  .hero h1 {
    margin-bottom: var(--space-3);
    max-width: 18ch;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.01em;
  }

  .hero__lead {
    margin-bottom: var(--space-5);
    max-width: 32rem;
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .hero__chip {
    display: grid;
    gap: 0.125rem;
    padding: var(--space-2) var(--space-3);
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    min-width: 5.5rem;
  }

  .hero__chip-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero__chip-value {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
  }

  .hero__list {
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .hero__list li {
    padding-left: 1.125rem;
    position: relative;
  }

  .hero__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.375rem;
    height: 1px;
    background: var(--color-wood);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* ── Visual / catalog frame ── */
  .hero__visual {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 32rem;
    justify-self: center;
    padding: var(--space-5) var(--space-4) var(--space-2);
  }

  .hero__catalog {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__dim {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .hero__dim--top {
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .hero__dim--side {
    right: 0;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    transform-origin: center center;
  }

  .hero__corner {
    position: absolute;
    width: 1rem;
    height: 1rem;
    color: var(--color-wood);
    opacity: 0.45;
  }

  .hero__corner--tl { top: 1.25rem; left: 0.5rem; }
  .hero__corner--tr { top: 1.25rem; right: 0.5rem; }
  .hero__corner--bl { bottom: 2.5rem; left: 0.5rem; }
  .hero__corner--br { bottom: 2.5rem; right: 0.5rem; }

  .hero__mat {
    position: relative;
    padding: var(--space-2);
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    overflow: visible;
  }

  :global(.hero__photo) {
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: min(52vw, 22rem);
    object-fit: cover;
    border-radius: var(--radius-sm);
    display: block;
  }

  .hero__stamp {
    position: absolute;
    padding: 0.3rem 0.55rem;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 1.5px solid;
    border-radius: 2px;
    line-height: 1.2;
    pointer-events: none;
  }

  .hero__stamp--size {
    top: -0.5rem;
    left: -0.25rem;
    color: var(--color-wood);
    border-color: var(--color-wood);
    background: var(--color-panel);
    transform: rotate(-3deg);
  }

  .hero__stamp--measure {
    bottom: 0.75rem;
    right: -0.5rem;
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-panel);
    transform: rotate(2deg);
  }

  .hero__ruler {
    display: block;
    width: 100%;
    max-width: 12rem;
    height: auto;
    margin: var(--space-2) auto 0;
    opacity: 0.7;
  }

  .hero__caption {
    margin-top: var(--space-2);
    padding-inline: var(--space-1);
    font-size: 0.75rem;
    color: var(--color-muted);
    text-align: center;
  }

  .hero__caption a {
    color: inherit;
    text-decoration: underline;
  }

  @media (min-width: 960px) {
    .hero__shell {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 520px);
      gap: clamp(2rem, 4vw, 3.5rem);
    }

    .hero__visual {
      justify-self: end;
      max-width: none;
      padding: var(--space-6) var(--space-5) var(--space-2);
    }

    .hero__blueprint {
      left: 2%;
      bottom: 5%;
      width: min(38vw, 420px);
      opacity: 0.16;
    }

    .hero__plan {
      right: 38%;
      top: 8%;
      width: 6.5rem;
      opacity: 0.1;
    }

    :global(.hero__photo) {
      max-height: 20rem;
    }
  }

  @media (max-width: 959px) {
    .hero__blueprint {
      left: auto;
      right: -8%;
      bottom: auto;
      top: 2%;
      width: min(70vw, 280px);
      opacity: 0.1;
    }

    .hero__plan {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Static layout only — no motion needed */
  }
</style>
