---
import { site } from '../data/site';
import { withBase } from '../lib/paths';
import ResponsiveImage from './ResponsiveImage.astro';

const primaryPhone = site.phones.find((p) => p.primary) ?? site.phones[0];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__location">{site.city} · корпусная мебель на заказ</p>
      <h1 id="hero-title">{site.offer.headline}</h1>
      <p class="hero__lead">{site.offer.subline}</p>

      <ul class="hero__facts">
        <li>Бесплатный замер и расчёт</li>
        <li>Своё производство в {site.city}</li>
        <li>Доставка и монтаж</li>
      </ul>

      <div class="hero__actions">
        <a class="btn btn--primary" href={withBase('/kontakty#zamer')}>{site.offer.cta}</a>
        <a class="btn btn--secondary" href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a>
      </div>
    </div>

    <figure class="hero__figure">
      <ResponsiveImage
        name="stock-hero-kitchen"
        alt="Кухня на заказ — работа МебельКа, Йошкар-Ола"
        width={1400}
        height={933}
        loading="eager"
        fetchpriority="high"
        sizes="(min-width: 960px) 46vw, 100vw"
        class="hero__photo"
      />
      <figcaption class="hero__caption">Фото из наших работ · ВКонтакте</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .hero__location {
    margin: 0 0 var(--space-3);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .hero h1 {
    margin-bottom: var(--space-4);
    max-width: 16ch;
  }

  .hero__lead {
    max-width: 34rem;
    color: var(--color-muted);
    font-size: 1.0625rem;
    margin-bottom: var(--space-5);
  }

  .hero__facts {
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
    color: var(--color-text);
    font-size: 0.9375rem;
  }

  .hero__facts li {
    padding-left: 1.25rem;
    position: relative;
  }

  .hero__facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--color-accent);
    border-radius: 1px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__figure {
    margin: 0;
    border: 1px solid var(--color-line);
    background: var(--color-panel);
  }

  :global(.hero__photo) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .hero__caption {
    padding: var(--space-2) var(--space-4);
    font-size: 0.75rem;
    color: var(--color-muted);
    border-top: 1px solid var(--color-line);
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr 1.05fr;
      gap: var(--space-8);
    }
  }
</style>
