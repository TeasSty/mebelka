---
import { site } from '../data/site';
import { withBase } from '../lib/paths';
import ResponsiveImage from './ResponsiveImage.astro';

const primaryPhone = site.phones.find((p) => p.primary) ?? site.phones[0];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__shell">
    <div class="hero__content">
      <p class="hero__eyebrow hero__reveal" style="--hero-delay: 0ms">
        <span class="hero__eyebrow-mark" aria-hidden="true"></span>
        {site.city} · корпусная мебель на заказ
      </p>

      <h1 id="hero-title" class="hero__reveal" style="--hero-delay: 90ms">{site.offer.headline}</h1>
      <p class="hero__lead hero__reveal" style="--hero-delay: 170ms">{site.offer.subline}</p>

      <ul class="hero__chips" aria-label="Преимущества">
        <li class="hero__chip">
          <span class="hero__chip-label">Рейтинг VK</span>
          <span class="hero__chip-value">{site.vk.rating}</span>
        </li>
        <li class="hero__chip">
          <span class="hero__chip-label">Замер</span>
          <span class="hero__chip-value">бесплатно</span>
        </li>
        <li class="hero__chip">
          <span class="hero__chip-label">Производство</span>
          <span class="hero__chip-value">своё</span>
        </li>
      </ul>

      <ul class="hero__list hero__reveal" style="--hero-delay: 420ms">
        <li>Кухни и шкафы-купе по вашим размерам</li>
        <li>Доставка и монтаж в {site.city}</li>
      </ul>

      <div class="hero__actions hero__reveal" style="--hero-delay: 500ms">
        <a class="btn btn--primary" href={withBase('/kontakty#zamer')}>{site.offer.cta}</a>
        <a class="btn btn--secondary" href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a>
      </div>
    </div>

    <figure class="hero__visual">
      <div class="hero__mat">
        <ResponsiveImage
          name="hero-kitchen"
          alt="Кухня на заказ — работа МебельКа, Йошкар-Ола"
          width={1280}
          height={960}
          loading="eager"
          fetchpriority="high"
          sizes="(min-width: 960px) min(44vw, 520px), 100vw"
          class="hero__photo"
        />
      </div>
      <figcaption class="hero__caption">Фото из наших работ · <a href={site.vk.url}>ВКонтакте</a></figcaption>
    </figure>
  </div>
</section>

<style>
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(0.625rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-visual-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem) scale(0.985);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes hero-mark-grow {
    from {
      transform: scaleX(0);
      transform-origin: left center;
    }

    to {
      transform: scaleX(1);
      transform-origin: left center;
    }
  }

  .hero {
    padding-block: clamp(2rem, 5vw, 3.25rem);
    background:
      linear-gradient(180deg, var(--color-panel) 0%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-line);
  }

  .hero__reveal {
    opacity: 0;
    animation: hero-rise 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--hero-delay, 0ms);
  }

  .hero__eyebrow-mark {
    transform: scaleX(0);
    animation: hero-mark-grow 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.15s forwards;
  }

  .hero__shell {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .hero__content {
    max-width: 36rem;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero__eyebrow-mark {
    flex-shrink: 0;
    width: 2rem;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent) 0%, var(--color-wood) 100%);
    border-radius: 1px;
  }

  .hero h1 {
    margin-bottom: var(--space-3);
    max-width: 18ch;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.01em;
  }

  .hero__lead {
    margin-bottom: var(--space-5);
    max-width: 32rem;
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .hero__chip {
    display: grid;
    gap: 0.125rem;
    padding: var(--space-2) var(--space-3);
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    min-width: 5.5rem;
    opacity: 0;
    animation: hero-rise 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero__chip:nth-child(1) {
    animation-delay: 250ms;
  }

  .hero__chip:nth-child(2) {
    animation-delay: 320ms;
  }

  .hero__chip:nth-child(3) {
    animation-delay: 390ms;
  }

  .hero__chip-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero__chip-value {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
  }

  .hero__list {
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .hero__list li {
    padding-left: 1.125rem;
    position: relative;
  }

  .hero__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.375rem;
    height: 1px;
    background: var(--color-wood);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__visual {
    margin: 0;
    width: 100%;
    max-width: 32rem;
    justify-self: center;
    opacity: 0;
    animation: hero-visual-in 0.75s cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards;
  }

  .hero__mat {
    padding: var(--space-2);
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }

  :global(.hero__photo) {
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: min(52vw, 22rem);
    object-fit: cover;
    border-radius: var(--radius-sm);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero__mat:hover :global(.hero__photo),
  .hero__mat:focus-within :global(.hero__photo) {
    transform: scale(1.025);
  }

  .hero__caption {
    margin-top: var(--space-2);
    padding-inline: var(--space-1);
    font-size: 0.75rem;
    color: var(--color-muted);
    text-align: center;
  }

  .hero__caption a {
    color: inherit;
    text-decoration: underline;
  }

  @media (min-width: 960px) {
    .hero__shell {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 520px);
      gap: clamp(2rem, 4vw, 3.5rem);
    }

    .hero__visual {
      justify-self: end;
      max-width: none;
    }

    :global(.hero__photo) {
      max-height: 20rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__reveal,
    .hero__visual,
    .hero__chip {
      opacity: 1;
      animation: none;
      transform: none;
    }

    .hero__eyebrow-mark {
      transform: none;
      animation: none;
    }

    :global(.hero__photo) {
      transition: none;
    }

    .hero__mat:hover :global(.hero__photo),
    .hero__mat:focus-within :global(.hero__photo) {
      transform: none;
    }
  }
</style>
