---
import type { Category } from '../data/categories';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import ContactForm from '../components/ContactForm.astro';
import { getPortfolioByCategory } from '../data/portfolio';
import { withBase } from '../lib/paths';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const works = getPortfolioByCategory(category.slug);
---

<BaseLayout
  title={`${category.name} — ${site.name}, ${site.city}`}
  description={category.description}
  path={category.path}
  ogImage={`/images/${category.heroImage}.jpg`}
>
  <section class="page-hero grid-bg">
    <div class="container page-hero__grid">
      <div>
        <p class="section__eyebrow">{site.city}</p>
        <h1>{category.headline}</h1>
        <p class="section__lead">{category.description}</p>
        <ul class="page-hero__features">
          {category.features.map((f) => <li>{f}</li>)}
        </ul>
        <div class="page-hero__actions">
          <a class="btn btn--primary" href={withBase('/kontakty#zamer')}>{site.offer.cta}</a>
          <a class="btn btn--secondary" href={withBase('/portfolio')}>Смотреть работы</a>
        </div>
      </div>
      <ResponsiveImage
        name={category.heroImage}
        alt={category.name}
        width={1080}
        height={1440}
        loading="eager"
        fetchpriority="high"
        sizes="(min-width: 960px) 45vw, 100vw"
        class="page-hero__img"
      />
    </div>
  </section>

  {
    works.length > 0 && (
      <section class="section">
        <div class="container">
          <p class="section__eyebrow">Примеры работ</p>
          <h2>{category.shortName} от {site.name}</h2>
          <PortfolioGrid items={works} />
          <p class="section__more">
            <a href={site.vk.albumsUrl}>Больше фото во ВКонтакте →</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section section--surface">
    <div class="container">
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .page-hero__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .page-hero__features {
    margin: 0 0 var(--space-5);
    padding-left: 1.1rem;
    color: var(--color-muted);
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  :global(.page-hero__img) {
    width: 100%;
    max-height: 36rem;
    object-fit: cover;
    border: 1px solid rgb(138 154 123 / 0.35);
  }

  .section--surface {
    background: var(--color-surface);
  }

  .section__more {
    margin-top: var(--space-5);
  }

  @media (min-width: 960px) {
    .page-hero__grid {
      grid-template-columns: 1fr 0.9fr;
    }
  }
</style>
