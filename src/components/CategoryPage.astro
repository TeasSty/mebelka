---
import type { Category } from '../data/categories';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import ContactForm from '../components/ContactForm.astro';
import { getPortfolioByCategory } from '../data/portfolio';
import { withBase } from '../lib/paths';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const works = getPortfolioByCategory(category.slug);
---

<BaseLayout
  title={`${category.name} — ${site.name}, ${site.city}`}
  description={category.description}
  path={category.path}
  ogImage={`/images/${category.heroImage}.jpg`}
>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__copy">
        <p class="section__eyebrow">{site.city}</p>
        <h1>{category.headline}</h1>
        <p class="section__lead">{category.description}</p>
        <ul class="page-hero__list">
          {category.features.map((f) => <li>{f}</li>)}
        </ul>
        <div class="page-hero__actions">
          <a class="btn btn--primary" href={withBase('/kontakty#zamer')}>{site.offer.cta}</a>
          <a class="btn btn--ghost" href={withBase('/portfolio')}>Все работы</a>
        </div>
      </div>
      <figure class="page-hero__figure">
        <ResponsiveImage
          name={category.heroImage}
          alt={category.name}
          width={1080}
          height={810}
          loading="eager"
          fetchpriority="high"
          sizes="(min-width: 960px) 45vw, 100vw"
          class="page-hero__img"
        />
      </figure>
    </div>
  </section>

  {
    works.length > 0 && (
      <section class="section section--surface">
        <div class="container">
          <p class="section__eyebrow">Примеры</p>
          <h2>{category.shortName} от {site.name}</h2>
          <PortfolioGrid items={works} />
          <p class="section__more">
            <a href={site.vk.albumsUrl}>Больше фото во ВКонтакте →</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 8vw, 5rem);
    background: var(--color-bg);
  }

  .page-hero__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .page-hero__list {
    margin: 0 0 var(--space-5);
    padding-left: 1.2rem;
    color: var(--color-muted);
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .page-hero__figure {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-soft);
    background: var(--color-panel);
  }

  :global(.page-hero__img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .section__more {
    margin-top: var(--space-5);
  }

  @media (min-width: 960px) {
    .page-hero__inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
