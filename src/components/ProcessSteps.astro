---
import { processSteps } from '../data/content';
---

<ol class="process">
  {
    processSteps.map((step) => (
      <li class="process__step">
        <span class="process__size">{step.size}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .process__step {
    padding: var(--space-5);
    background: var(--color-panel);
    border-left: 3px solid var(--color-accent);
    border-bottom: 1px solid rgb(138 154 123 / 0.25);
  }

  .process__size {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-line);
    margin-bottom: var(--space-2);
  }

  .process__step h3 {
    margin-bottom: var(--space-2);
  }

  .process__step p {
    margin: 0;
    color: var(--color-muted);
  }

  @media (min-width: 768px) {
    .process {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
