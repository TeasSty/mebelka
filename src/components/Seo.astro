---
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
}

const {
  title = site.title,
  description = site.description,
  path = '/',
  ogImage = '/images/hero-kitchen.jpg',
} = Astro.props;

const siteOrigin = import.meta.env.SITE ?? site.url;
const base = import.meta.env.BASE_URL;
const canonicalPath = path === '/' ? base : `${base}${path.replace(/^\//, '')}`;
const canonical = new URL(canonicalPath, siteOrigin).href;
const og = new URL(ogImage.replace(/^\//, ''), new URL(base, siteOrigin)).href;
const primaryPhone = site.phones.find((p) => p.primary) ?? site.phones[0];

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'FurnitureStore',
  name: site.name,
  description: site.description,
  url: siteOrigin,
  telephone: primaryPhone.tel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'RU',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '20:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '10:00',
      closes: '17:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Sunday',
      opens: '10:00',
      closes: '15:00',
    },
  ],
  sameAs: [site.vk.url],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.vk.rating,
    bestRating: 5,
  },
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="ru_RU" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />
<meta name="geo.region" content="RU-ME" />
<meta name="geo.placename" content={site.city} />
<script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
