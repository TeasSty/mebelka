---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { withBase } from '../lib/paths';
---

<BaseLayout title={`Страница не найдена — ${site.name}`} path="/404">
  <section class="section not-found">
    <div class="container not-found__inner">
      <p class="section__eyebrow">404</p>
      <h1>Такой страницы нет</h1>
      <p class="section__lead">
        Возможно, ссылка устарела. Перейдите на главную или запишитесь на бесплатный замер.
      </p>
      <div class="not-found__actions">
        <a class="btn btn--primary" href={withBase()}>На главную</a>
        <a class="btn btn--secondary" href={withBase('/kontakty#zamer')}>{site.offer.cta}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>
