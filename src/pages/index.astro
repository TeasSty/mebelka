---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroGallery from '../components/HeroGallery.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import FaqList from '../components/FaqList.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
import { portfolio } from '../data/portfolio';
import { withBase } from '../lib/paths';
---

<BaseLayout>
  <HeroGallery />

  <section class="section">
    <div class="container">
      <p class="section__eyebrow">Направления</p>
      <h2>Мебель для каждой комнаты</h2>
      <p class="section__lead">
        Кухни, шкафы-купе, прихожие, детская и офис — изготавливаем по вашим размерам и материалам.
      </p>
      <CategoryGrid />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container features">
      <p class="section__eyebrow">Почему {site.name}</p>
      <h2>Спокойный процесс без сюрпризов</h2>
      <div class="features__grid">
        {
          site.features.map((f) => (
            <article class="features__card">
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
      <p class="features__materials">
        Материалы:
        {site.materials.map((m) => (
          <span>{m}</span>
        ))}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="section__eyebrow">Процесс</p>
      <h2>От замера до монтажа</h2>
      <p class="section__lead">Четыре понятных шага — вы всегда знаете, на каком этапе ваш заказ.</p>
      <ProcessSteps />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <p class="section__eyebrow">Портфолио</p>
      <h2>Реальные работы</h2>
      <p class="section__lead">
        Фото из сообщества <a href={site.vk.url}>ВКонтакте</a>. Полный архив — в альбомах группы.
      </p>
      <PortfolioGrid items={portfolio} limit={6} />
      <p class="section__more">
        <a class="btn btn--secondary" href={withBase('/portfolio')}>Все работы</a>
      </p>
    </div>
  </section>

  <ReviewsSection />

  <section class="section">
    <div class="container">
      <p class="section__eyebrow">FAQ</p>
      <h2>Частые вопросы</h2>
      <FaqList />
    </div>
  </section>

  <section class="section section--surface" id="zamer">
    <div class="container">
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .features__grid {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .features__card {
    padding: var(--space-5);
    background: var(--color-panel);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line);
  }

  .features__card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-2);
  }

  .features__card p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .features__materials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .features__materials span {
    padding: 0.35rem 0.85rem;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--color-text);
  }

  .section__more {
    margin-top: var(--space-6);
  }

  @media (min-width: 768px) {
    .features__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
