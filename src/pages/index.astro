---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import FaqList from '../components/FaqList.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
import { portfolio } from '../data/portfolio';
import { withBase } from '../lib/paths';
---

<BaseLayout ogImage="/images/hero-kitchen.jpg">
  <Hero />

  <section class="section">
    <div class="container">
      <p class="section__eyebrow">Направления</p>
      <h2>Что изготавливаем</h2>
      <p class="section__lead">
        Кухни, шкафы-купе, прихожие, детская и офисная мебель — по вашим размерам.
      </p>
      <CategoryGrid />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container features">
      <p class="section__eyebrow">Почему {site.name}</p>
      <h2>Работаем честно и по делу</h2>
      <div class="features__grid">
        {
          site.features.map((f) => (
            <article class="features__card">
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
      <p class="features__materials">
        Материалы:
        {site.materials.map((m) => (
          <span>{m}</span>
        ))}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="section__eyebrow">Процесс</p>
      <h2>Как проходит заказ</h2>
      <ProcessSteps />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <p class="section__eyebrow">Наши работы</p>
      <h2>Фото из ВКонтакте</h2>
      <p class="section__lead">
        Реальные проекты из сообщества <a href={site.vk.url}>МебельКа</a>. Больше — в альбомах группы.
      </p>
      <PortfolioGrid items={portfolio} limit={6} />
      <p class="section__more">
        <a class="btn btn--secondary" href={withBase('/portfolio')}>Все работы</a>
      </p>
    </div>
  </section>

  <ReviewsSection />

  <section class="section">
    <div class="container">
      <p class="section__eyebrow">FAQ</p>
      <h2>Частые вопросы</h2>
      <FaqList />
    </div>
  </section>

  <section class="section section--surface" id="zamer">
    <div class="container">
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .features__grid {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .features__card {
    padding: var(--space-5);
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }

  .features__card h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
  }

  .features__card p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .features__materials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .features__materials span {
    padding: 0.25rem 0.65rem;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: var(--color-text);
  }

  .section__more {
    margin-top: var(--space-5);
  }

  @media (min-width: 768px) {
    .features__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
